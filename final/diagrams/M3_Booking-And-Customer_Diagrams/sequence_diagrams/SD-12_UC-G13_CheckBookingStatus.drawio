        <mxCell id="note_0" value="Read-only; a reservation code or any room code can find the whole reservation.&lt;br&gt;RoomType population is kept inside Booking's query for the assigned model scope.&lt;br&gt;No status filter is applied: pending, cancelled and completed bookings are visible.&lt;br&gt;The endpoint has no explicit missing-field validation; unmatched input gives&lt;br&gt;NOT_FOUND." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="846.4" y="940" width="548.4" height="82" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="setQuery({code, email})" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.0108;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0108;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_G_6" target="bar_UI_5"><mxGeometry relative="1" as="geometry"/></mxCell>
