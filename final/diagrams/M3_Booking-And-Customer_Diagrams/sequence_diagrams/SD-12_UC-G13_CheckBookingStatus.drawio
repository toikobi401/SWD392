        <mxCell id="msg_2" value="GET /api/bookings/lookup?code=&amp;amp;email=&lt;br&gt;lookup(req, res)" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.1941;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0132;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_UI_5" target="bar_C_4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="msg_3" value="lookup(req, res)&lt;br&gt;trim and uppercase code; trim and lowercase email; no authentication" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;rounded=0;fontSize=11;exitX=1;exitY=0.033;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.0759;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_C_4" target="bar_C_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910.4" y="298"/><mxPoint x="910.4" y="324"/></Array></mxGeometry></mxCell>
        <mxCell id="msg_4" value="findOne({$or: [{bookingCode: trimmed}, {reservationCode: trimmed}],&lt;br&gt;&quot;guest.email&quot;: normalizedEmail})" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.1485;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0851;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_C_4" target="bar_B_1"><mxGeometry relative="1" as="geometry"/></mxCell>
