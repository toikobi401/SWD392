        <mxCell id="note_0" value="Date-order, past-date and 30-night checks are in the page.&lt;br&gt;The search endpoint only rejects unparseable dates.&lt;br&gt;Filter refinement and +/- 3-day calendars are specified but absent in&lt;br&gt;code.&lt;br&gt;UC-G02 room details and UC-G06 public offers are separate use cases." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="557" y="1402" width="475.4" height="82" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Service/rule orchestration is folded into search(req, res).&lt;br&gt;Supporting Room and InventoryHold queries are summarized on C&lt;br&gt;to retain the assigned RoomType and Booking entity lifelines." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="972.4" y="1500" width="742.55" height="54" as="geometry"/></mxCell>
