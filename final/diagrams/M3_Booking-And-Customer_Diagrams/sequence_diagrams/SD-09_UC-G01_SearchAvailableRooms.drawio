        <mxCell id="msg_1" value="&quot;Check-in cannot be in the past.&quot;" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;dashed=1;endArrow=open;endSize=8;exitX=0;exitY=0.0581;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.0581;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_UI_9" target="bar_G_10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="msg_2" value="&quot;Check-out must be after check-in.&quot;" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;dashed=1;endArrow=open;endSize=8;exitX=0;exitY=0.108;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.108;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_UI_9" target="bar_G_10"><mxGeometry relative="1" as="geometry"/></mxCell>
