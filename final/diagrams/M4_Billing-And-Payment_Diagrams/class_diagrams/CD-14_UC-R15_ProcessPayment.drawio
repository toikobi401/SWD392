        <mxCell id="note_0" value="FolioPage includes the TakePayment component in DeskPages.tsx.&lt;br&gt;Controller operations fold middleware, service, drawer and&lt;br&gt;audit work.&lt;br&gt;Payment.folioId is optional; a folio may have many payments.&lt;br&gt;Gateway settlement is referenced in SD-13." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620.425" y="552.1258" width="419" height="84" as="geometry"/></mxCell>
