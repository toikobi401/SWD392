        <mxCell id="note_0" value="BookingDetailPage includes RefundDialog from CustomerPages.tsx.&lt;br&gt;UI offers requests for CANCELLED bookings after seven days.&lt;br&gt;Booking/payment eligibility queries and audit work are folded into C.&lt;br&gt;No attachment, non-refundable-rate check or manager notification is implemented." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="134" width="1115" height="68" as="geometry"/></mxCell>
