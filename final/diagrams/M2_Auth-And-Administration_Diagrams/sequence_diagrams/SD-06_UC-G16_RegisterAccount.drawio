        <mxCell id="note_0" value="RegisterPage represents registration and the VerifyEmailPage continuation.&lt;br&gt;User represents the base model and its Customer discriminator.&lt;br&gt;Supporting Role, LoyaltyAccount and audit work is summarized on Controller." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="518" y="134" width="865.6" height="54" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Role.findOne({ name: CUSTOMER }); use its id&lt;br&gt;if found.&lt;br&gt;bcrypt.hash(password, 12); status =&lt;br&gt;PENDING_VERIFICATION.&lt;br&gt;Phone uniqueness is not checked by the&lt;br&gt;server." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="912.4" y="988" width="300" height="96" as="geometry"/></mxCell>
        <mxCell id="note_2" value="LoyaltyAccount.create({ customerId,&lt;br&gt;pointBalance: 0 })&lt;br&gt;runs before verification, as implemented." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="912.4" y="1432" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="note_3" value="Error is caught and logged; registration&lt;br&gt;continues.&lt;br&gt;The log mentions retry, but no retry queue&lt;br&gt;exists here." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="912.4" y="1688" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="note_4" value="jwt.verify(token, secret); link lifetime is&lt;br&gt;24 hours." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="912.4" y="2150" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_5" value="The implementation does not check the update&lt;br&gt;result." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="912.4" y="2432" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_6" value="Google sign-up, checkout registration and verification resend&lt;br&gt;are specified but have no implementation for this flow.&lt;br&gt;verify(token) is the existing authApi method, folded into this&lt;br&gt;UI boundary.&lt;br&gt;Email operations use NotificationProxy; development may log&lt;br&gt;the message." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="518" y="2594" width="412.4" height="96" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="submit(e) - fullName, email, phone, passwords, acceptedTerms" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.0048;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0048;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_G_7" target="bar_UI_6"><mxGeometry relative="1" as="geometry"/></mxCell>
