        <mxCell id="msg_5" value="401 TOKEN_EXPIRED / INVALID_TOKEN" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;dashed=1;endArrow=open;endSize=8;exitX=0;exitY=0.0881;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.1044;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_C_13" target="bar_UI_14"><mxGeometry relative="1" as="geometry"/></mxCell>
