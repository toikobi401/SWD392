        <mxCell id="frame_5" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=20;" vertex="1" parent="1"><mxGeometry x="873" y="2046" width="373.2" height="120" as="geometry"/></mxCell>
        <mxCell id="frame_5_guard0" value="[expiresAt or reason supplied through the API]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="939" y="2046" width="289.2" height="20" as="geometry"/></mxCell>
        <mxCell id="note_0" value="Precondition: UC-A01 loaded the account; UC-A05 loaded the role&lt;br&gt;catalogue.&lt;br&gt;AccountsPage includes its AccountDrawer: held roles and GUEST are&lt;br&gt;filtered out.&lt;br&gt;Service, middleware and audit logic is folded into Controller." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="479.6" y="134" width="475.4" height="82" as="geometry"/></mxCell>
        <mxCell id="note_1" value="The following three queries run in&lt;br&gt;Promise.all in the service." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="937" y="704" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_2" value="Append role._id to user.roles." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="937" y="1724" width="213" height="26" as="geometry"/></mxCell>
        <mxCell id="note_3" value="invalidateSessions is a stub. sessionsInvalidatedAt is&lt;br&gt;absent from the schema and authenticate does not check it.&lt;br&gt;Existing JWTs are not immediately revoked." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="895" y="1974" width="532.1" height="54" as="geometry"/></mxCell>
        <mxCell id="note_4" value="Include expiresAt and reason in audit&lt;br&gt;metadata.&lt;br&gt;No expiry field, scheduler or effective-date&lt;br&gt;support exists." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="937" y="2080" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="note_5" value="Effective permissions are the union of&lt;br&gt;role.permissions." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="937" y="2376" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_6" value="assignRole is the existing adminApi method used by AccountDrawer's&lt;br&gt;mutation.&lt;br&gt;Initial provisioning invokes the same assignment service (UC-A02).&lt;br&gt;Revoke and LAST_SUPER_ADMIN belong to UC-A08, not this POST.&lt;br&gt;replace() calls revoke then assign; it has no route and is not atomic.&lt;br&gt;Permission preview/confirmation and automatic expiry are spec-only.&lt;br&gt;Email operations use NotificationProxy; development may log the notice." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="479.6" y="2574" width="475.4" height="110" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="assignRole(id, roleId) - select a role and click Add" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.0036;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0036;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_A_15" target="bar_UI_14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="msg_1" value="POST /api/accounts/:id/roles (roleId, expiresAt?, reason?)&lt;br&gt;assignRole(req, res)" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.0214;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0036;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_UI_14" target="bar_C_13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="msg_2" value="authenticate(req, res, next)" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;rounded=0;fontSize=11;exitX=1;exitY=0.0091;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.0191;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_C_13" target="bar_C_13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="959" y="300"/><mxPoint x="959" y="322"/></Array></mxGeometry></mxCell>
