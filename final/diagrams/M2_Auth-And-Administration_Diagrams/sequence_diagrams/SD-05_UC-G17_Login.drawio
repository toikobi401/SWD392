        <mxCell id="note_0" value="Service and middleware logic is folded into the Controller.&lt;br&gt;Role population is part of the User query; audit writes are summarized." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="808" y="134" width="488" height="40" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Increment failedLoginAttempts.&lt;br&gt;At 5 failures, set status = LOCKED." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="1026" width="244.5" height="40" as="geometry"/></mxCell>
        <mxCell id="note_2" value="The fifth failure still returns 401.&lt;br&gt;A later attempt returns 403 ACCOUNT_LOCKED." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="506" y="1382" width="362" height="40" as="geometry"/></mxCell>
        <mxCell id="note_3" value="Set failedLoginAttempts = 0 and lastLoginAt =&lt;br&gt;now." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="1558" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_4" value="Tokens: access 15 minutes, refresh 7 days.&lt;br&gt;Forgot-password extension is SD-07.&lt;br&gt;Google OAuth and verification resend have no&lt;br&gt;implemented route.&lt;br&gt;Email operations use NotificationProxy; without a&lt;br&gt;provider,&lt;br&gt;development logs the message instead of delivering it." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="506" y="1900" width="362" height="110" as="geometry"/></mxCell>
