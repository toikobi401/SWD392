        <mxCell id="note_0" value="Service logic is folded into Controller; audit writes are&lt;br&gt;summarized.&lt;br&gt;Implementation gap: resetOtpHash and resetOtpExpiresAt are&lt;br&gt;assigned&lt;br&gt;dynamically by AuthService but are absent from the User&lt;br&gt;schema.&lt;br&gt;They are not persisted by save(); the later request normally&lt;br&gt;returns&lt;br&gt;INVALID_OTP. The intended success branch is shown&lt;br&gt;conditionally below." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="896.2" y="134" width="400" height="152" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Generate a 6-digit OTP and bcrypt.hash(otp,&lt;br&gt;10).&lt;br&gt;Assign resetOtpHash and resetOtpExpiresAt =&lt;br&gt;now + 10 minutes." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="938.2" y="594" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="note_2" value="Check user, OTP hash, expiry Date and&lt;br&gt;bcrypt.compare(otp, hash)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="938.2" y="1436" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_3" value="passwordHash = bcrypt.hash(newPassword, 12).&lt;br&gt;Set failedLoginAttempts = 0 and clear OTP&lt;br&gt;hash and expiry." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="938.2" y="1614" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="note_4" value="Set status = ACTIVE; other statuses are&lt;br&gt;unchanged." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="938.2" y="1720" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_5" value="Both endpoints are public; the Customer need not be signed in.&lt;br&gt;EMAIL is the client's default channel; the service also accepts SMS.&lt;br&gt;No reset confirmation email or session revocation is implemented.&lt;br&gt;Email operations use NotificationProxy; development may log the OTP." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="499.7" y="2042" width="456.5" height="68" as="geometry"/></mxCell>
