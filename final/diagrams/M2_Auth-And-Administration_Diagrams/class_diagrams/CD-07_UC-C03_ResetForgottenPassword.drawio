        <mxCell id="note_0" value="AuthService and audit logic are folded into this boundary.&lt;br&gt;Both endpoints are public. An unknown email returns the same&lt;br&gt;200 message as a successful OTP request; delivery failure returns&lt;br&gt;500." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1049.375" y="569.3758" width="433" height="70" as="geometry"/></mxCell>
        <mxCell id="note_0_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_0" target="cls_AuthController"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Only actual schema attributes are listed.&lt;br&gt;resetOtpHash and resetOtpExpiresAt are not in userSchema.&lt;br&gt;Dynamic assignments made by requestPasswordReset() are not persisted.&lt;br&gt;SD-07 labels the intended success branch as conditional on valid&lt;br&gt;OTP fields being available; the current schema prevents that flow.&lt;br&gt;select() is a Mongoose query-chain operation." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="248.975" y="815.4758" width="455" height="108.1094" as="geometry"/></mxCell>
        <mxCell id="note_1_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_1" target="cls_User"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_2" value="NotificationProxy.sendOtp() represents this external&lt;br&gt;call.&lt;br&gt;The UI uses EMAIL; the service also accepts SMS.&lt;br&gt;Development without a configured provider logs the&lt;br&gt;OTP." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="813.05" y="843.6508" width="348" height="84" as="geometry"/></mxCell>
        <mxCell id="note_2_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_2" target="cls_EmailService"><mxGeometry relative="1" as="geometry"/></mxCell>
