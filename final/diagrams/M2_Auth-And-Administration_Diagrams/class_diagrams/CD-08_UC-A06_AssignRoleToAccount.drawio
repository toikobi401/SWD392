        <mxCell id="cls_Permission_a16" value="MANAGE_ROLES" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="cls_Permission"><mxGeometry y="328" width="180" height="18" as="geometry"/></mxCell>
        <mxCell id="cls_Permission_a17" value="MANAGE_SETTINGS" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="cls_Permission"><mxGeometry y="346" width="180" height="18" as="geometry"/></mxCell>
        <mxCell id="cls_Permission_a18" value="VIEW_AUDIT_LOG" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="cls_Permission"><mxGeometry y="364" width="180" height="18" as="geometry"/></mxCell>
        <mxCell id="cls_Permission_a19" value="MANAGE_BACKUP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="cls_Permission"><mxGeometry y="382" width="180" height="18" as="geometry"/></mxCell>
        <mxCell id="note_0" value="Includes AccountDrawer, whose mutation invokes&lt;br&gt;adminApi.assignRole().&lt;br&gt;Account and role-catalogue loading are preconditions from&lt;br&gt;UC-A01/A05." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="896.425" y="285.3258" width="445" height="70" as="geometry"/></mxCell>
        <mxCell id="note_0_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_0" target="cls_AccountsPage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Service and middleware operations are folded into this&lt;br&gt;boundary.&lt;br&gt;record() summarizes AuditService.record().&lt;br&gt;ADMIN and MANAGER are the implemented conflicting role pair.&lt;br&gt;Only a SUPER_ADMIN may grant SUPER_ADMIN." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="980.375" y="561.3258" width="395" height="84" as="geometry"/></mxCell>
        <mxCell id="note_1_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_1" target="cls_AccountController"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_2" value="populate() is a Mongoose query-chain operation.&lt;br&gt;sessionsInvalidatedAt is not a schema field; its update is a&lt;br&gt;stub.&lt;br&gt;authenticate() does not enforce that timestamp against existing&lt;br&gt;JWTs.&lt;br&gt;expiresAt and reason are audit metadata, not assignment&lt;br&gt;attributes.&lt;br&gt;No automatic role-expiry scheduler is implemented." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="565.225" y="830.4258" width="427" height="126" as="geometry"/></mxCell>
        <mxCell id="note_2_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_2" target="cls_User"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_3" value="NotificationProxy.sendDecisionNotice() represents this external&lt;br&gt;call.&lt;br&gt;Delivery errors are ignored; development may log the notice." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1097.1" y="858.6008" width="414" height="56" as="geometry"/></mxCell>
        <mxCell id="note_3_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_3" target="cls_EmailService"><mxGeometry relative="1" as="geometry"/></mxCell>
