        <mxCell id="note_0" value="Includes the VerifyEmailPage continuation required by this use&lt;br&gt;case.&lt;br&gt;verify(token) is authApi.verify(), invoked by that page's&lt;br&gt;effect." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1089.625" y="324.4258" width="419" height="70" as="geometry"/></mxCell>
        <mxCell id="note_0_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_0" target="cls_RegisterPage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Service and middleware operations are folded into this boundary.&lt;br&gt;Role lookup, LoyaltyAccount.create() and audit writes are&lt;br&gt;summarized&lt;br&gt;in SD-06 to retain the assigned User-only model view.&lt;br&gt;Loyalty account creation precedes email verification in the code." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1065.475" y="640.6758" width="427" height="84" as="geometry"/></mxCell>
        <mxCell id="note_1_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_1" target="cls_AuthController"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_2" value="create(fields) is Customer.create(), the User discriminator,&lt;br&gt;which inserts into the users collection with userType =&lt;br&gt;Customer.&lt;br&gt;The verification update does not check whether a user was&lt;br&gt;found." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="248.975" y="964.4008" width="399" height="84" as="geometry"/></mxCell>
        <mxCell id="note_2_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_2" target="cls_User"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_3" value="NotificationProxy.sendVerificationLink() represents this&lt;br&gt;external call.&lt;br&gt;Delivery errors are caught; registration still returns 201.&lt;br&gt;Development without a configured provider logs the email." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="748.075" y="964.4008" width="415" height="70" as="geometry"/></mxCell>
        <mxCell id="note_3_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_3" target="cls_EmailService"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel_0" value="POST /api/auth/register&lt;br&gt;GET /api/auth/verify?token=" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="cls_RegisterPage" target="cls_AuthController"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rel_1" value="" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="cls_AuthController" target="cls_User"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rel_2" value="verification link" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="cls_AuthController" target="cls_EmailService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
