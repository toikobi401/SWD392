        <mxCell id="note_0" value="Service and middleware operations are folded into this boundary&lt;br&gt;to match SD-05. record() summarizes AuditService.record().&lt;br&gt;issueTokens() issues a 15-minute access token and 7-day refresh&lt;br&gt;token." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1113.2" y="580.8758" width="442" height="70" as="geometry"/></mxCell>
