        <mxCell id="note_2" value="NotificationProxy.sendDecisionNotice() represents this external&lt;br&gt;call.&lt;br&gt;Development without a configured provider logs the email." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="769.35" y="914.9508" width="414" height="56" as="geometry"/></mxCell>
