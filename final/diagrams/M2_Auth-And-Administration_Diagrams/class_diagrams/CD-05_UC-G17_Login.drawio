        <mxCell id="note_1" value="select() and populate() are Mongoose query-chain operations.&lt;br&gt;roles references Role documents; population is included in&lt;br&gt;findOne().&lt;br&gt;This use-case view retains the assigned User model boundary." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="248.4" y="905.7508" width="418" height="70" as="geometry"/></mxCell>
