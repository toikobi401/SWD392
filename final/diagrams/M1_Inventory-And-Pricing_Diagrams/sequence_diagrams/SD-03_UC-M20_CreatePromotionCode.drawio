        <mxCell id="msg_1" value="show new-code form and worked discount example&lt;br&gt;10 percent, today through day 30, unlimited uses,&lt;br&gt;no minimum spend, not public" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;dashed=1;endArrow=open;endSize=8;exitX=0;exitY=0.8857;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.8857;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_UI_0" target="bar_M_1"><mxGeometry relative="1" as="geometry"/></mxCell>
