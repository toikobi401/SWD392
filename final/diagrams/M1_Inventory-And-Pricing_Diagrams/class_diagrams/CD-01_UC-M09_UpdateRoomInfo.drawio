        <mxCell id="note_0" value="SD-01 action mapping:&lt;br&gt;&quot;select a room to edit&quot; = selectRoomToEdit(id)&lt;br&gt;&quot;edit roomNumber, floor, notes and save&quot;&lt;br&gt;= saveRoomInfo(roomNumber, floor, notes, version).&lt;br&gt;Dashed responses return results to these actions." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="537.05" y="283.6008" width="420" height="96.789" as="geometry"/></mxCell>
        <mxCell id="note_0_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_0" target="cls_RoomInventoryPage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Design only: RoomInventoryPage, getRoom and updateRoom&lt;br&gt;and both routes are proposed by the unchanged SD-01.&lt;br&gt;GET maps to getRoom; PATCH maps to updateRoom.&lt;br&gt;&quot;validate input&quot; maps to validateInput.&lt;br&gt;Middleware is folded into this boundary.&lt;br&gt;PATCH uses _id + version, $set fields and $inc version.&lt;br&gt;Returns 400, 401/403, 409 for duplicate roomNumber,&lt;br&gt;409 ROOM_CHANGED for no match, or 200 with the room." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="368" y="523.3758" width="374" height="140.8125" as="geometry"/></mxCell>
        <mxCell id="note_1_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_1" target="cls_RoomController"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel_0" value="GET /api/rooms/:id&lt;br&gt;PATCH /api/rooms/:id" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="cls_RoomInventoryPage" target="cls_RoomController"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="558.9" y="185.8508"/></Array></mxGeometry></mxCell>
