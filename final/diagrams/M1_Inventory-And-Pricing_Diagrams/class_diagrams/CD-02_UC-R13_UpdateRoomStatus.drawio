        <mxCell id="note_0" value="onAction is the page callback that&lt;br&gt;invokes&lt;br&gt;update.mutate({ event, notes }).&lt;br&gt;The room rack is already loaded&lt;br&gt;(UC-R12)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="614.675" y="256.0008" width="267" height="84" as="geometry"/></mxCell>
