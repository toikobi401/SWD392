        <mxCell id="note_1" value="Middleware and RoomStatusService.apply logic&lt;br&gt;are folded into this boundary; next is the&lt;br&gt;RoomStateMachine.next operation, not a new endpoint.&lt;br&gt;ASSIGN and CHECK_OUT are rejected with 400 USE_CHECK_IN_OUT.&lt;br&gt;IllegalStateTransitionError currently maps to&lt;br&gt;500 INTERNAL_ERROR in errorHandler." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430.1" y="472.2008" width="440" height="108.1094" as="geometry"/></mxCell>
