        <mxCell id="note_0" value="Middleware, PromotionService, PromotionRule and&lt;br&gt;AuditService helpers are folded into this&lt;br&gt;boundary.&lt;br&gt;Only create(req, res) is the HTTP handler.&lt;br&gt;AuditLog.entityId is a String, not a schema&lt;br&gt;reference.&lt;br&gt;Booking usage is read by detail() after creation." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="598" y="704.5008" width="329" height="112" as="geometry"/></mxCell>
        <mxCell id="note_0_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_0" target="cls_PromotionController"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_1" value="submit is PromotionDialog's form handler,&lt;br&gt;represented within its owning&lt;br&gt;PromotionsPage.&lt;br&gt;setCreating(true) opens the creation&lt;br&gt;dialog." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="619.275" y="327.3008" width="292" height="84" as="geometry"/></mxCell>
