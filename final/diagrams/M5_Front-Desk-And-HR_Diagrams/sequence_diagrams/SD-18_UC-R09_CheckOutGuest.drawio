        <mxCell id="frame_8_guard0" value="[booking.customerId exists]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1077.6" y="2374" width="169.5" height="20" as="geometry"/></mxCell>
        <mxCell id="note_0" value="DeskPages.tsx: StaffBookingPage contains CheckOutPanel.&lt;br&gt;In-house booking and folio reference are already displayed.&lt;br&gt;Supporting Booking, Charge, Invoice, Task and loyalty persistence&lt;br&gt;is folded into coordinator self-messages on C." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="555.2" y="134" width="538.4" height="68" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Load Booking.findById(bookingId).&lt;br&gt;Require BookingStateMachine.can(status,&lt;br&gt;CHECK_OUT)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1075.6" y="680" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="note_2" value="Charge.exists checks for an existing&lt;br&gt;Late check-out surcharge line on this folio.&lt;br&gt;A retry must not post the charge twice." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1075.6" y="1258" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="note_3" value="Create surcharge and VAT Charge lines;&lt;br&gt;compute net and tax." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1075.6" y="1402" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_4" value="Read undisputed Charge lines; sum net and TAX&lt;br&gt;separately.&lt;br&gt;Generate sequential invoice number;&lt;br&gt;Invoice.create.&lt;br&gt;Set booking CHECKED_OUT and actualCheckOutAt;&lt;br&gt;save booking." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1075.6" y="1876" width="300" height="96" as="geometry"/></mxCell>
        <mxCell id="note_5" value="Task.create: high-priority cleaning task for&lt;br&gt;this room." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1075.6" y="2298" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_6" value="LoyaltyAccount.findOneAndUpdate with upsert:&lt;br&gt;increment pointBalance and lifetimePoints&lt;br&gt;by floor(booking.subtotal * 0.01)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1075.6" y="2446" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="note_7" value="Code gates on balance minus deposit but does not zero the balance,&lt;br&gt;apply/refund the deposit, or remove disputed amounts from that gate.&lt;br&gt;Invoice lines exclude disputes. Payment is UC-R15; no gateway/email&lt;br&gt;call occurs here. Early-departure repricing, express/corporate billing,&lt;br&gt;invoice email and review invitation are not implemented in this flow." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="555.2" y="2714" width="538.4" height="82" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="submitCheckOut(lateCheckoutSurcharge, waiveSurcharge)" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.0034;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0034;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_A_12" target="bar_UI_11"><mxGeometry relative="1" as="geometry"/></mxCell>
