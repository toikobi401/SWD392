        <mxCell id="note_0" value="StaffPages.tsx: ApprovalsPage contains LeaveDecision.&lt;br&gt;Employee, Shift, policy and audit work is folded into C.&lt;br&gt;EmailService represents NotificationProxy's EMAIL provider." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="604.4" y="134" width="601.4" height="54" as="geometry"/></mxCell>
