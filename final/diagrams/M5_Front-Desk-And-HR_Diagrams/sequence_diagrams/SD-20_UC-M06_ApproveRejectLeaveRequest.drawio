        <mxCell id="note_3" value="Count scheduled and on-leave Shift documents.&lt;br&gt;Minimum coverage defaults to 2;&lt;br&gt;blackoutPeriods = []." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1187.8" y="2084" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="note_4" value="Set toDate = partialToDate and days =&lt;br&gt;grantedDays.&lt;br&gt;API-only option: current UI does not submit&lt;br&gt;it.&lt;br&gt;No separate request is created for remaining&lt;br&gt;days." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1187.8" y="2758" width="300" height="96" as="geometry"/></mxCell>
        <mxCell id="note_5" value="If type != UNPAID: decrement employee sick&lt;br&gt;balance&lt;br&gt;for SICK, otherwise annual balance, by&lt;br&gt;grantedDays.&lt;br&gt;Shift.updateMany marks affected dates&lt;br&gt;isOnLeave = true." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1187.8" y="3266" width="300" height="96" as="geometry"/></mxCell>
        <mxCell id="note_6" value="Code reads PENDING then saves without a conditional status/version lock;&lt;br&gt;a decision made after the read is not reliably rejected as a conflict.&lt;br&gt;Insufficient balance is a warning, not a server rejection. No conversion&lt;br&gt;to unpaid, bulk decision or request splitting exists in this flow.&lt;br&gt;Escalation returns before notification/audit; blackout dates are unconfigured.&lt;br&gt;Department filters the queue but is not enforced on the decision endpoint." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="604.4" y="3816" width="601.4" height="96" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="openLeaveApprovals(department)" style="html=1;verticalAlign=bottom;rounded=0;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.0112;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.0112;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bar_A_4" target="bar_UI_3"><mxGeometry relative="1" as="geometry"/></mxCell>
