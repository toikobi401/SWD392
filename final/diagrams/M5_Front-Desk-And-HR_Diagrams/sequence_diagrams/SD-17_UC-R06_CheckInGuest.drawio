        <mxCell id="note_0" value="DeskPages.tsx: StaffBookingPage contains CheckInPanel.&lt;br&gt;Booking search/detail is a precondition (UC-R01/R02).&lt;br&gt;Service, rule and supporting persistence steps are folded into C." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="555.2" y="134" width="519.5" height="54" as="geometry"/></mxCell>
        <mxCell id="note_1" value="Clear selected room and refetch allocatable&lt;br&gt;rooms&lt;br&gt;using the GET flow above before another&lt;br&gt;attempt." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="597.2" y="2222" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="note_2" value="API supports this audit; current UI lists&lt;br&gt;only the booked type." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1056.7" y="2440" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="note_3" value="Remaining coordinator steps: create OPEN&lt;br&gt;folio,&lt;br&gt;store depositAmount (defaults to 0), post&lt;br&gt;room/services&lt;br&gt;net charge and VAT, credit PAID prepayments." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1056.7" y="2708" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="note_4" value="Code does not enforce settlement before check-in, charge early arrivals,&lt;br&gt;manage waiting lists, or print registration cards. Walk-in creation and&lt;br&gt;payment collection are separate use cases. No external call occurs here." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="555.2" y="3024" width="519.5" height="54" as="geometry"/></mxCell>
