        <mxCell id="note_0" value="StaffPages.tsx: submit mutation sends the leave form.&lt;br&gt;Scope is submission; listing and cancellation are separate&lt;br&gt;interactions.&lt;br&gt;This route authenticates only; no permission middleware is&lt;br&gt;configured." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="386.9" y="134" width="412.4" height="82" as="geometry"/></mxCell>
        <mxCell id="note_1" value="employeeId = req.auth.sub; parse dates.&lt;br&gt;Reject toDate earlier than fromDate." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="781.3" y="496" width="269.7" height="40" as="geometry"/></mxCell>
        <mxCell id="note_2" value="days = floor((toDate - fromDate) / 86400000)&lt;br&gt;+ 1" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="781.3" y="712" width="300" height="40" as="geometry"/></mxCell>
