        <mxCell id="note_0" value="Self-message operations fold middleware, leave service, policy and&lt;br&gt;audit&lt;br&gt;logic into this boundary, as in SD-20; they are not extra&lt;br&gt;endpoints.&lt;br&gt;Supporting Employee/Shift work remains within these operations." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="790.625" y="872.9758" width="437" height="84" as="geometry"/></mxCell>
        <mxCell id="note_0_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_0" target="cls_LeaveController"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_1" value="StaffPages.tsx: LeaveDecision is part of ApprovalsPage.&lt;br&gt;Page actions name UI interactions; onError/onSuccess are real&lt;br&gt;callbacks.&lt;br&gt;Query chain operations are shown on their owning model." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="894.125" y="416.4258" width="449" height="70" as="geometry"/></mxCell>
        <mxCell id="note_1_link" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="note_1" target="cls_ApprovalsPage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_2" value="Represents NotificationProxy.sendDecisionNotice's EMAIL destination.&lt;br&gt;With no NOTIFICATION_API_URL, development mode logs the message locally." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="346.725" y="1248.4508" width="485" height="42.7031" as="geometry"/></mxCell>
