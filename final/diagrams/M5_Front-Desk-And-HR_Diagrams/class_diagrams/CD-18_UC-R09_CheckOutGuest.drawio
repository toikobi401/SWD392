        <mxCell id="note_1" value="No direct Folio-Room schema reference exists.&lt;br&gt;The relationship is indirect via Booking, outside this&lt;br&gt;assigned pair:&lt;br&gt;Folio.bookingId is required and unique; Booking.roomId is&lt;br&gt;optional." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="177.1" y="917.2508" width="404" height="84" as="geometry"/></mxCell>
