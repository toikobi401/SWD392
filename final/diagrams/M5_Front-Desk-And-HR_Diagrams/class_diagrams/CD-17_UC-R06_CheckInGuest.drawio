        <mxCell id="note_0" value="Self-message operations fold middleware, coordinator, rule and&lt;br&gt;audit&lt;br&gt;logic into this boundary, as in SD-17; they are not extra&lt;br&gt;endpoints.&lt;br&gt;checkIn(command) summarizes supporting folio/ledger&lt;br&gt;persistence." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="442.75" y="752.2258" width="415" height="98" as="geometry"/></mxCell>
