        <mxCell id="RoomStatus-53" value="OUT_OF_ORDER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;" vertex="1" parent="RoomStatus"><mxGeometry x="0" y="112" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="note-0" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;BR-25  a Room holds at most one active stay — allocation is an optimistic&lt;br&gt;            lock on Room.version (race-free between receptionists)&lt;br&gt;BR-28  the Folio balance must reach 0 before the stay is closed&lt;br&gt;Every taxable Charge is posted together with its VAT line (FolioLedger)&lt;br&gt;Check-in opens the Folio; check-out closes it and issues the Invoice&lt;br&gt;Check-out: Room → VACANT_DIRTY and a housekeeping Task is raised&lt;br&gt;Guest identity is verified at check-in but not stored as an entity —&lt;br&gt;            only the document number goes to the AuditLog&lt;br&gt;BR-29  loyalty points (1 % of room revenue) credited at check-out" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFDE7;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="680" y="800" width="560" height="178" as="geometry"/></mxCell>
