# ==============================================
# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# ==============================================

# ==============================================
# 🗄️ DATABASE CONFIGURATION (MongoDB)
# ==============================================
MONGODB_URI=mongodb://localhost:27017/hms

# ==============================================
# 🔐 AUTHENTICATION & SECURITY  (BR-01..BR-03)
# ==============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-value

# ==============================================
# 🌐 SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ==============================================
# 💳 PAYMENT GATEWAY — payOS  (UC-G10, UC-R15, UC-A12)
# ==============================================
# From https://my.payos.vn → Kênh thanh toán → your channel → "Thông tin tích hợp".
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# Optional — only if you are in the payOS partner programme.
# PAYOS_PARTNER_CODE=
# Optional — override for tests / a mock server. Defaults to the live API.
# PAYOS_BASE_URL=https://api-merchant.payos.vn

# ==============================================
# 📧 NOTIFICATIONS  (UC-G12)
# ==============================================
NOTIFICATION_API_URL=https://api.notifications.example
NOTIFICATION_API_KEY=

# ==============================================
# 🏨 HOTEL BUSINESS CONFIGURATION
# ==============================================
# BR-41 — minimum staff on duty per department when approving leave.
MIN_DEPARTMENT_COVERAGE=2
